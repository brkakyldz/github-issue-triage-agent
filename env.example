# Copy to .env (gitignored) and fill in:  cp env.example .env

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna        # optional; this is the default

# The repository to triage, and a fine-grained personal access token scoped to that
# one repository with "Issues: Read and write" (Metadata: read is added automatically).
GITHUB_REPO=owner/repo
GITHUB_TOKEN=

# Optional: trace every run to LangSmith (the free Developer plan is enough).
# Traces land in the LangSmith project "github-issue-triage-agent".
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
